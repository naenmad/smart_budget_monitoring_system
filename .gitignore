# ================================================================
# Smart Budget Monitoring System - .gitignore
# PT Summit Adyawinsa Indonesia
# ================================================================

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.local
.env.*.local
backend/.env
*.pem
*.key

# --- Python / Flask Backend ---
venv/
backend/venv/
__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
instance/
.pytest_cache/
.coverage
htmlcov/
backend/ai/models/svm_model_*.pkl

# --- Node / React Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.vite/
frontend/.vite/

# --- Uploaded Excel & Temporary Files ---
uploads/
backend/uploads/
!uploads/.gitkeep
!backend/uploads/.gitkeep
*.xlsx
*.xls

# --- Logs (keep folder structure only) ---
logs/*.log
logs/**/*.log
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Development Tools (not for production) ---
pyrightconfig.json
fix_css.py
.pytest_cache/

# --- Platform-specific (use Docker only) ---
backend/render.yaml
frontend/vercel.json
backend/Procfile

# --- AI Agent Internal Files (dev only) ---
.agents/
agents.md