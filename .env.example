# ================================================================
# Smart Budget Monitoring System - Docker Environment Variables
# PT Summit Adyawinsa Indonesia
#
# CARA PENGGUNAAN:
#   cp .env.example .env
#   Edit file .env sesuai konfigurasi server Anda
#   docker compose up -d --build
# ================================================================

# --- MySQL Database ---
DB_PASSWORD=GANTI_PASSWORD_DB_ANDA
DB_NAME=smart_budget_db

# --- Application Security (WAJIB diganti sebelum deploy!) ---
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_SECRET_KEY_ANDA
JWT_SECRET_KEY=GANTI_JWT_SECRET_KEY_ANDA
# Batasi origin CORS untuk production (pisahkan koma jika lebih dari satu)
CORS_ORIGINS=*

# --- Port Mapping (opsional, sesuaikan jika port sudah dipakai) ---
MYSQL_PORT=3306
PMA_PORT=8080
BACKEND_PORT=5001
FRONTEND_PORT=80
