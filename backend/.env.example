# ================================================================
# Smart Budget Monitoring System - Environment Variables
# PT Summit Adyawinsa Indonesia
#
# CARA PENGGUNAAN:
#   cp .env.example .env
#   Lalu isi setiap nilai di bawah sesuai konfigurasi server Anda
# ================================================================

# --- MySQL Database Configuration ---
# DB_HOST harus 'mysql' saat menggunakan Docker Compose
# (nama service di docker-compose.yml)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=GANTI_PASSWORD_ANDA_DISINI
DB_NAME=smart_budget_db

# --- Application Security Keys ---
# WAJIB diganti dengan string acak yang panjang sebelum deploy ke production!
# Generate contoh: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_SECRET_KEY_ANDA_DISINI
JWT_SECRET_KEY=GANTI_JWT_SECRET_KEY_ANDA_DISINI

# --- Flask Environment ---
FLASK_ENV=production
PORT=5001
